.PHONY: all en zh build clean distclean parallel Alexander_Grothendieck Alexander_Grothendieck_zh Bernhard_Riemann Bernhard_Riemann_zh Carl_Friedrich_Gauss Carl_Friedrich_Gauss_zh Emmy_Noether Emmy_Noether_zh Leonhard_Euler Leonhard_Euler_zh

all:
	@for d in $(SUBDIRS); do \
	  echo "==> $$d"; \
	  $(MAKE) -C $$d pdf || exit $$?; \
	done
	@echo "✅ 全部完成。仅保留各子目录下的 PDF。"

en:
	@for d in $(EN_SUBDIRS); do echo "==> $$d"; $(MAKE) -C $$d pdf || exit $$?; done

zh:
	@for d in $(ZH_SUBDIRS); do echo "==> $$d"; $(MAKE) -C $$d pdf || exit $$?; done

build:
	@for d in $(SUBDIRS); do echo "==> $$d"; $(MAKE) -C $$d build || exit $$?; done

clean:
	@for d in $(SUBDIRS); do $(MAKE) -C $$d clean; done

distclean:
	@for d in $(SUBDIRS); do $(MAKE) -C $$d distclean; done

parallel:
	$(MAKE) -j $$(sysctl -n hw.ncpu 2>/dev/null || echo 4) all


